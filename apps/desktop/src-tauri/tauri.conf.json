{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowMate",
  "version": "0.1.0",
  "identifier": "dev.flowmate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "FlowMate", "create": false, "width": 1000, "height": 750 },
      { "label": "quick", "title": "FlowMate — 快捷助理", "url": "index.html?window=quick", "create": false, "visible": false, "width": 520, "height": 720 },
      { "label": "ball", "title": "FlowMate", "url": "index.html?window=ball", "create": false, "visible": false, "width": 88, "height": 88, "decorations": false, "resizable": false, "shadow": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "focusable": false }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:5173; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": false, "targets": ["nsis"], "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "skip" }, "nsis": { "installMode": "currentUser" } }
  }
}
